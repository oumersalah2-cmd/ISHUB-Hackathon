{
  "name": "ai-customer-support-resolution-agent",
  "version": "1.0.0",
  "private": true,
  "description": "AI Customer Support Resolution Agent for university hackathon",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "npm --workspace=frontend run dev",
    "dev:backend": "npm --workspace=backend run dev",
    "build": "npm --workspace=frontend run build && npm --workspace=backend run build",
    "build:frontend": "npm --workspace=frontend run build",
    "build:backend": "npm --workspace=backend run build",
    "test": "npm --workspace=backend run test",
    "seed": "npm --workspace=backend run seed"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
